// The game on Cloudflare: a Worker that serves the static build and, on the relay's paths, the hub (worker/, docs/DRIFT.md).
// Requests for static assets are free and unlimited and never run the Worker. Upload only with `bun run deploy`,
// which runs the whole quality gate first.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "under-stockholm",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "assets": {
    // Built by `bun run deploy` with the real SITE_URL. `dist/_headers` caches the hashed assets for good.
    "directory": "./dist",
    "binding": "ASSETS",
    // /en and /en/ both find en/index.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Only these reach the Worker; every other path is a file. The same paths as the Bun relay in development.
    "run_worker_first": ["/ghosts", "/feeds/*", "/notes", "/notes/*", "/perf", "/errors"]
  },
  // The hub: other players, notes, performance and error reports and the live feeds, one object for everyone (worker/hub.ts).
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // Per address, on what would reach the hub: sockets, notes and reports (worker/index.ts). A player uses a few a
  // minute; this leaves room for a school or a mobile operator's shared address.
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "vars": {
    // Requests a day other players may spend on the Durable Object, on Workers Paid: at most about $0.15 a day past
    // the plan's included million a month (docs/DRIFT.md, section 3). Keep a number rather than `off`, which leaves no
    // ceiling on the bill.
    "GHOST_BUDGET": "1000000",
    // Requests a day the feeds, notes and reports may spend, apart from the players' budget so neither can spend the
    // other: at most about $0.05 a day. Each data center's cache answers most feeds, so the hub sees few of them.
    "DATA_BUDGET": "300000"
  },
  // Secrets, set once with `bunx wrangler secret put <name>`: TRAFIKLAB_RT_KEY and TRAFIKLAB_STATIC_KEY (GTFS Regional,
  // every line follows SL; without them the blue line alone, from the Transport API), NOTES_ADMIN_TOKEN (to take a
  // note down).
  // The game's address, with www too; the pages name the bare domain as canonical. The domain's DNS is on Cloudflare
  // (registered at Spaceship, name servers pointed here). workers.dev stays on as a second way in for testing.
  "routes": [
    { "pattern": "understockholm.com", "custom_domain": true },
    { "pattern": "www.understockholm.com", "custom_domain": true }
  ],
  "workers_dev": true,
  // Logs from the hub (a source failing, the GTFS timetable loading), kept a few days.
  "observability": { "enabled": true }
}
