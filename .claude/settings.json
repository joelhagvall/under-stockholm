{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/hooks/before-bash.ts\"", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/hooks/after-edit.ts\"", "timeout": 60 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/hooks/before-stop.ts\"", "timeout": 30 }]
      }
    ]
  }
}
